# PayBack AI - Environment Variables Template
PORT=5000
LINK_EXPIRY_MINUTES=30
ADMIN_PASSWORD=admin123

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration (Optional - logs to console if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=PayBack AI Recovery <no-reply@payback.ai>

# Razorpay Test Mode Credentials (Optional - uses internal fallback if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
